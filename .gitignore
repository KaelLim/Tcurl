# 環境變數（包含敏感資訊）— 一律不進版控，只保留範本
.env
.env.*
*.env
*_env
!.env.example
# Workers 本機 secrets（cf dev / Vite plugin 會讀取）
.dev.vars
.dev.vars.*

# Cloudflare 建置輸出、本機模擬狀態、產生的型別
.cloudflare/
.wrangler/

# 依賴套件
node_modules/

# 編譯輸出
dist/

# 日誌檔案
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 執行時產生的檔案
public/qrcodes/*.png

# 編輯器設定
.vscode/
.idea/
*.swp
*.swo
*~

# 作業系統檔案
.DS_Store
Thumbs.db

# 測試覆蓋率
coverage/
.nyc_output/

# 快取
.cache/
.npm/
.eslintcache

# PM2
.pm2/

